# Regenerable Step 3 alignment visualizations (~33 MB for the current probe)
# Recreate with: python scripts/run_step3.py align --config configs/step3_alignment.yaml
artifacts/step3/alignment/**/*.png

# Regenerable Step 3.5-A heatmap panel PNGs
# Recreate with: python scripts/run_step3.py heatmap-smoke --config configs/step3_heatmap.yaml
artifacts/step3/heatmap/**/*.png

# Regenerable Step 3.5-B fusion enhanced heatmap PNGs
# Recreate with: python scripts/run_step3.py fusion-smoke --config configs/step3_fusion.yaml
artifacts/step3/fusion/**/*.png

